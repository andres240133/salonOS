# ============================================================
# SalonOS — Variables de Entorno
# Copiar este archivo como .env y completar los valores reales.
# NUNCA commitear el archivo .env al repositorio.
# ============================================================

# --- Base de Datos ---
# TODO: Reemplazar con la URL de conexión de Railway PostgreSQL
DATABASE_URL=postgresql://postgres:salonos_dev_password@localhost:5432/salonos_db

# --- Autenticación JWT ---
# TODO: Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=changeme_generate_64_random_bytes_hex
JWT_REFRESH_SECRET=changeme_generate_64_random_bytes_hex_different

# Duración de tokens (formato ms/vercel)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Cifrado de Datos PII (AES-256-GCM) ---
# TODO: Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Debe ser exactamente 32 bytes (64 hex chars)
ENCRYPTION_KEY=changeme_generate_32_random_bytes_hex

# --- Hashing con Salt (SHA-256) ---
# Salt fijo del sistema para phone_hash en tabla clients
# TODO: Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SYSTEM_SALT=changeme_generate_32_random_bytes_hex_for_phone_hash

# Salt para anonimizar IPs en audit_logs
# TODO: Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUDIT_SALT=changeme_generate_32_random_bytes_hex_for_ip_hash

# --- WhatsApp Cloud API (Meta Business Suite) ---
# TODO: Obtener desde Meta Developer Portal → WhatsApp → API Setup
WHATSAPP_TOKEN=your_permanent_whatsapp_access_token
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id
WHATSAPP_WEBHOOK_SECRET=your_webhook_verify_token

# --- Servidor Backend ---
PORT=3000
NODE_ENV=development

# URL del frontend PWA (para CORS)
FRONTEND_PWA_URL=http://localhost:5174
FRONTEND_PUBLIC_URL=http://localhost:5173
